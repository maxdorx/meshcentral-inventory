<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inventory</title>
    <link id="inventoryTheme" rel="stylesheet">
    <style>
        :root {
            color-scheme: dark light;
            --inv-accent: var(--bs-primary, #168fbd);
            --inv-border: var(--bs-border-color, rgba(128, 128, 128, .35));
            --inv-muted: var(--bs-secondary-color, #9aa0a6);
            --inv-surface: var(--bs-tertiary-bg, rgba(128, 128, 128, .12));
            --inv-fg: #e8e8e8;
            --inv-on-accent: #fff;
            --inv-gutter: 20px;
        }
        html.inv-classic-light {
            color-scheme: light;
            --inv-border: rgba(0, 0, 0, .22);
            --inv-muted: #5f6368;
            --inv-surface: rgba(0, 0, 0, .045);
        }
        html.inv-classic-light .inv-button { background: #f3f3f3; color: #171717; }
        html.inv-classic-light .inv-button.primary { background: var(--inv-accent); color: #fff; }
        html.inv-classic-light .inv-input,
        html.inv-classic-light .inv-select,
        html.inv-classic-light .inv-textarea { background: #fff; color: #171717; }
        html.inv-classic-light .inv-table th { background: #e5e5e5; color: #171717; }
        * { box-sizing: border-box; }
        html, body { height: 100%; min-height: 0; overflow: hidden; }
        body {
            margin: 0;
            padding: 16px var(--inv-gutter) 0;
            background: var(--bs-body-bg, #1f1f1f);
            color: var(--inv-fg, #e8e8e8);
            font-family: var(--bs-body-font-family, Arial, sans-serif);
            font-size: 14px;
        }
        button, input, select, textarea { font: inherit; }
        .inv-shell, .inv-shell h1, .inv-shell h2, .inv-shell h3,
        .inv-shell table, .inv-shell th, .inv-shell td, .inv-shell dt, .inv-shell dd,
        .inv-shell label, .inv-shell button, .inv-shell input, .inv-shell select,
        .inv-shell textarea { color: var(--inv-fg, #e8e8e8) !important; }
        .inv-shell .inv-muted, .inv-shell .inv-field label, .inv-shell .inv-card-label { color: var(--inv-muted) !important; }
        .inv-shell .inv-button.primary { color: var(--inv-on-accent, #fff) !important; }
        .inv-shell .inv-button.danger { color: #fff !important; }
        .inv-shell .inv-online { color: var(--bs-success, #198754) !important; }
        .inv-shell .inv-review { color: var(--bs-warning, #ffc107) !important; }
        .inv-shell { width: 100%; height: 100%; min-height: 0; }
        .inv-dashboard:not(.hidden) { display: flex; flex-direction: column; height: 100%; min-height: 0; }
        .inv-header { display: flex; gap: 16px; justify-content: space-between; align-items: center; margin-bottom: 14px; }
        .inv-dashboard-actions { justify-content: flex-end; margin-bottom: 10px; }
        .inv-title { margin: 0; font-size: 26px; font-weight: 650; }
        .inv-subtitle { color: var(--inv-muted); margin-top: 3px; }
        .inv-actions { display: flex; gap: 8px; flex-wrap: wrap; }
        .inv-button {
            border: 1px solid var(--inv-border); border-radius: 5px; padding: 7px 12px;
            background: var(--bs-secondary-bg, #343a40); color: inherit; cursor: pointer;
        }
        .inv-button:hover { filter: brightness(1.12); }
        .inv-button.primary { background: var(--inv-accent); border-color: var(--inv-accent); color: #fff; }
        .inv-button.danger { background: var(--bs-danger, #b02a37); border-color: var(--bs-danger, #b02a37); color: #fff; }
        .inv-button.small { padding: 4px 8px; font-size: 12px; }
        .inv-button:disabled { cursor: not-allowed; opacity: .55; }
        .inv-hidden { display: none !important; }
        .inv-tabs { display: flex; gap: 4px; margin-bottom: 8px; border-bottom: 1px solid var(--inv-border); }
        .inv-tab { border: 0; border-bottom: 3px solid transparent; padding: 9px 15px; background: transparent; color: var(--inv-fg, #e8e8e8) !important; cursor: pointer; font-weight: 650; }
        .inv-tab.active { border-bottom-color: var(--inv-accent); color: var(--inv-accent) !important; }
        .inv-grid { display: grid; grid-template-columns: repeat(6, minmax(130px, 1fr)); gap: 10px; margin-bottom: 14px; }
        .inv-card { border: 1px solid var(--inv-border); border-radius: 7px; background: var(--inv-surface); padding: 13px; color: inherit; text-align: left; cursor: pointer; }
        .inv-card:hover { border-color: var(--inv-accent); }
        .inv-card.active { border-color: var(--inv-accent); box-shadow: inset 0 0 0 1px var(--inv-accent); }
        .inv-card-label { color: var(--inv-muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
        .inv-card-value { margin-top: 5px; font-size: 25px; font-weight: 700; }
        .inv-toolbar {
            display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
            margin-right: calc(0px - var(--inv-gutter)); margin-left: calc(0px - var(--inv-gutter));
            padding: 10px var(--inv-gutter); border: 1px solid var(--inv-border); border-right: 0; border-left: 0;
        }
        .inv-toolbar-spacer { flex: 1 1 auto; }
        .inv-pagination { display: flex; align-items: center; gap: 6px; }
        .inv-input, .inv-select, .inv-textarea {
            border: 1px solid var(--inv-border); border-radius: 5px; padding: 7px 9px;
            background: var(--bs-body-bg, #222); color: inherit;
        }
        .inv-input { min-width: 230px; }
        .inv-textarea { min-height: 95px; resize: vertical; width: 100%; }
        .inv-table-wrap {
            flex: 1 1 auto; min-height: 180px;
            margin-right: calc(0px - var(--inv-gutter)); margin-left: calc(0px - var(--inv-gutter));
            border-top: 0; overflow: auto; overscroll-behavior: contain; scrollbar-gutter: stable;
        }
        .inv-table { width: 100%; border-collapse: collapse; min-width: 1050px; }
        .inv-table th { position: sticky; top: 0; z-index: 1; background: var(--bs-secondary-bg, #333); text-align: left; padding: 7px 9px; white-space: nowrap; }
        .inv-table td { border-top: 1px solid var(--inv-border); padding: 6px 9px; vertical-align: middle; }
        .inv-table th:first-child, .inv-table td:first-child { padding-left: var(--inv-gutter); }
        .inv-table th:last-child, .inv-table td:last-child { padding-right: var(--inv-gutter); }
        .inv-table tbody tr { cursor: pointer; }
        .inv-table tbody tr:hover { background: rgba(64, 160, 210, .12); }
        .inv-device-cell { min-width: 140px; }
        .inv-device, .inv-device-cell .inv-muted { font-weight: 650; white-space: nowrap; }
        .inv-device-cell .inv-muted { font-weight: 400; }
        .inv-muted { color: var(--inv-muted); }
        .inv-mono { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 12px; }
        .inv-badge { display: inline-block; border-radius: 999px; padding: 3px 8px; font-size: 12px; border: 1px solid var(--inv-border); white-space: nowrap; }
        .inv-badge.assigned { background: rgba(25, 135, 84, .2); color: var(--bs-success-text-emphasis, #75b798); }
        .inv-badge.available, .inv-badge.discovered { background: rgba(13, 110, 253, .18); color: var(--bs-info-text-emphasis, #6edff6); }
        .inv-badge.in-repair { background: rgba(255, 193, 7, .18); color: var(--bs-warning-text-emphasis, #ffda6a); }
        .inv-badge.retired, .inv-badge.lost-stolen { background: rgba(220, 53, 69, .17); color: var(--bs-danger-text-emphasis, #ea868f); }
        .inv-review { color: var(--bs-warning, #ffc107); font-weight: 650; }
        .inv-empty { padding: 42px 16px; text-align: center; color: var(--inv-muted); }
        .inv-loading { opacity: .65; pointer-events: none; }
        .inv-detail { display: none; }
        .inv-detail.open {
            display: block; height: 100%; overflow: auto; overscroll-behavior: contain;
            margin-right: calc(0px - var(--inv-gutter)); padding-right: var(--inv-gutter); padding-bottom: 16px;
        }
        .inv-dashboard.hidden { display: none; }
        .inv-detail-grid { display: grid; grid-template-columns: minmax(320px, 1fr) minmax(320px, 1fr); gap: 12px; }
        .inv-section { border: 1px solid var(--inv-border); border-radius: 7px; background: var(--inv-surface); padding: 14px; margin-bottom: 12px; }
        .inv-section h2 { font-size: 17px; margin: 0 0 12px; }
        .inv-section h3 { font-size: 14px; margin: 0 0 8px; }
        .inv-fields { display: grid; grid-template-columns: 150px 1fr; gap: 8px 12px; align-items: start; }
        .inv-fields dt { color: var(--inv-muted); }
        .inv-fields dd { margin: 0; word-break: break-word; }
        .inv-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .inv-field { display: flex; flex-direction: column; gap: 4px; }
        .inv-field.full { grid-column: 1 / -1; }
        .inv-field label { color: var(--inv-muted); font-size: 12px; }
        .inv-user { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 0; border-top: 1px solid var(--inv-border); }
        .inv-user:first-of-type { border-top: 0; }
        .inv-user-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
        .inv-history { max-height: none; overflow: visible; }
        .inv-history-item { border-left: 2px solid var(--inv-accent); padding: 2px 0 10px 10px; margin-left: 4px; }
        .inv-history-action { font-weight: 650; }
        .inv-toast { position: fixed; right: 18px; bottom: 18px; max-width: 440px; padding: 11px 14px; border-radius: 6px; background: #222; color: #fff; box-shadow: 0 4px 22px rgba(0,0,0,.35); display: none; z-index: 20; }
        .inv-toast.error { background: #842029; }
        .inv-modal-backdrop { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.68); }
        .inv-modal { width: min(900px, 100%); max-height: calc(100vh - 40px); overflow: auto; border: 1px solid var(--inv-border); border-radius: 8px; background: var(--bs-body-bg, #202124); color: inherit; box-shadow: 0 10px 40px rgba(0,0,0,.5); }
        .inv-modal-header, .inv-modal-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--inv-border); }
        .inv-modal-footer { justify-content: flex-end; border-top: 1px solid var(--inv-border); border-bottom: 0; }
        .inv-modal-body { padding: 16px; }
        .inv-modal h2 { margin: 0; font-size: 19px; }
        .inv-close { border: 0; background: transparent; color: inherit; font-size: 24px; cursor: pointer; }
        .inv-import-summary { margin-bottom: 10px; font-weight: 650; }
        .inv-import-errors { color: var(--bs-danger-text-emphasis, #ea868f); }
        .inv-preview-wrap { max-height: 360px; overflow: auto; border: 1px solid var(--inv-border); }
        .inv-preview { width: 100%; border-collapse: collapse; min-width: 760px; }
        .inv-preview th { position: sticky; top: 0; background: var(--bs-secondary-bg, #333); text-align: left; padding: 7px; }
        .inv-preview td { border-top: 1px solid var(--inv-border); padding: 7px; vertical-align: top; }
        .inv-online { color: var(--bs-success, #198754); }
        .inv-offline { color: var(--inv-muted); }
        @media (max-width: 1100px) {
            .inv-grid { grid-template-columns: repeat(3, 1fr); }
            .inv-detail-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 650px) {
            :root { --inv-gutter: 10px; }
            body { padding-top: 10px; }
            .inv-header { align-items: flex-start; flex-direction: column; }
            .inv-grid { grid-template-columns: repeat(2, 1fr); }
            .inv-form-grid { grid-template-columns: 1fr; }
            .inv-field.full { grid-column: auto; }
            .inv-fields { grid-template-columns: 115px 1fr; }
        }
    </style>
</head>
<body>
<div class="inv-shell" id="inventoryRoot">
    <section class="inv-dashboard" id="dashboard">
        <nav class="inv-tabs" id="inventoryTabs" aria-label="Inventory type">
            <button class="inv-tab active" id="workstationsTab" type="button">Workstations</button>
            <button class="inv-tab" id="peripheralsTab" type="button">Peripherals</button>
        </nav>
        <header class="inv-header inv-dashboard-actions">
            <div class="inv-actions">
                <button class="inv-button" id="exportButton" type="button">Export CSV</button>
                <button class="inv-button primary" id="rescanButton" type="button">Synchronize</button>
                <button class="inv-button" id="settingsButton" type="button">Inventory settings</button>
                <button class="inv-button primary" id="addWorkstationButton" type="button">Add workstation</button>
                <button class="inv-button" id="templateButton" type="button">Download CSV template</button>
                <button class="inv-button" id="importButton" type="button">Import CSV</button>
                <button class="inv-button primary" id="addPeripheralButton" type="button">Add peripheral</button>
                <input id="importFileInput" class="inv-hidden" type="file" accept=".csv,text/csv">
            </div>
        </header>

        <section class="inv-section inv-hidden" id="settingsPanel">
            <h2>Inventory settings</h2>
            <h3>Stale device policy</h3>
            <div class="inv-form-grid">
                <div class="inv-field"><label for="staleMode">Detection</label><select class="inv-select" id="staleMode"><option value="meshcentral">Follow MeshCentral removal settings</option><option value="custom">Custom threshold</option><option value="disabled">Disable stale detection</option></select></div>
                <div class="inv-field"><label for="staleDays">Custom threshold, days</label><input class="inv-input" id="staleDays" type="number" min="1" step="1" value="30"></div>
            </div>
            <p class="inv-muted">When MeshCentral auto-removal is off, the default threshold is 30 days. Missing nodes still require review.</p>
            <div class="inv-field">
                <label for="ignoredUsers">Ignored sign-in accounts (one per line)</label>
                <textarea class="inv-textarea" id="ignoredUsers" rows="4" placeholder="adminadmin&#10;Administrator@dax.local"></textarea>
                <span class="inv-muted">A plain username matches that name in any domain or UPN. A qualified name matches only the exact account. Ignored accounts are excluded from automatic assignment and signed-in user review.</span>
            </div>
            <p class="inv-review" id="settingsWarning"></p>
            <button class="inv-button primary" id="saveSettings" type="button">Save settings</button>
        </section>

        <div class="inv-grid" id="summaryCards"></div>

        <div class="inv-toolbar">
            <input class="inv-input" id="searchInput" type="search" placeholder="Search device, serial, user, location…">
            <select class="inv-select" id="statusFilter"><option value="">All lifecycle states</option></select>
            <select class="inv-select inv-hidden" id="typeFilter"><option value="">All peripheral types</option></select>
            <select class="inv-select" id="reviewFilter">
                <option value="">All review states</option>
                <option value="review">Needs review</option>
                <option value="clear">No review</option>
            </select>
            <select class="inv-select" id="presenceFilter">
                <option value="">All agent states</option>
                <option value="online">Online</option>
                <option value="offline">Offline</option>
                <option value="stale7">Not seen for 7+ days</option>
                <option value="stale30">Not seen for 30+ days</option>
                <option value="stale90">Not seen for 90+ days</option>
            </select>
            <select class="inv-select" id="recordFilter"><option value="active">Active records</option><option value="archived">Archived records</option></select>
            <span class="inv-toolbar-spacer"></span>
            <select class="inv-select" id="pageSize" aria-label="Rows per page">
                <option value="10">10 per page</option>
                <option value="25" selected>25 per page</option>
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>
            </select>
            <div class="inv-pagination">
                <button class="inv-button small" id="previousPage" type="button">Previous</button>
                <span class="inv-muted" id="resultCount"></span>
                <button class="inv-button small" id="nextPage" type="button">Next</button>
            </div>
        </div>

        <div class="inv-table-wrap">
            <table class="inv-table">
                <thead id="assetHead"><tr>
                    <th>Device</th><th>Status</th><th>Assignee</th><th>Serial</th><th>UUID</th>
                    <th>Model</th><th>Location</th><th>Agent</th><th>Review</th>
                </tr></thead>
                <tbody id="assetRows"></tbody>
            </table>
            <div class="inv-empty" id="emptyState">Loading inventory…</div>
        </div>
    </section>

    <section class="inv-detail" id="detail">
        <header class="inv-header">
            <div>
                <h1 class="inv-title" id="detailTitle">Asset</h1>
                <div class="inv-subtitle" id="detailSubtitle"></div>
            </div>
            <div class="inv-actions">
                <button class="inv-button" id="openDeviceButton" type="button">Open device</button>
                <button class="inv-button danger" id="deleteButton" type="button">Delete inventory record</button>
                <button class="inv-button primary" id="saveButton" type="button">Save changes</button>
            </div>
        </header>

        <div class="inv-detail-grid">
            <div>
                <section class="inv-section">
                    <h2>Lifecycle</h2>
                    <div class="inv-form-grid">
                        <div class="inv-field"><label for="statusInput">Status</label><select class="inv-select" id="statusInput"></select></div>
                        <div class="inv-field"><label for="assetTagInput">Asset tag</label><input class="inv-input" id="assetTagInput" maxlength="128"></div>
                        <div class="inv-field"><label for="locationInput">Location</label><input class="inv-input" id="locationInput" maxlength="256"></div>
                        <div class="inv-field"><label for="purchaseDateInput">Purchase date</label><input class="inv-input" id="purchaseDateInput" type="date"></div>
                        <div class="inv-field"><label for="warrantyEndInput">Warranty end</label><input class="inv-input" id="warrantyEndInput" type="date"></div>
                        <div class="inv-field full"><label for="notesInput">Notes</label><textarea class="inv-textarea" id="notesInput" maxlength="4000"></textarea></div>
                    </div>
                </section>

                <section class="inv-section">
                    <h2 id="hardwareTitle">Hardware identity</h2>
                    <dl class="inv-fields" id="hardwareFields"></dl>
                </section>
                <section class="inv-section inv-hidden" id="peripheralEditSection">
                    <h2>Peripheral details</h2>
                    <div class="inv-form-grid">
                        <div class="inv-field"><label for="peripheralTypeInput">Type</label><select class="inv-select" id="peripheralTypeInput"></select></div>
                        <div class="inv-field"><label for="peripheralNameInput">Name</label><input class="inv-input" id="peripheralNameInput" maxlength="256"></div>
                        <div class="inv-field"><label for="peripheralSerialInput">Serial number</label><input class="inv-input" id="peripheralSerialInput" maxlength="128"></div>
                        <div class="inv-field"><label for="peripheralManufacturerInput">Manufacturer</label><input class="inv-input" id="peripheralManufacturerInput" maxlength="256"></div>
                        <div class="inv-field"><label for="peripheralModelInput">Model</label><input class="inv-input" id="peripheralModelInput" maxlength="256"></div>
                        <div class="inv-field"><label for="peripheralUserInput">Assigned user</label><input class="inv-input" id="peripheralUserInput" maxlength="256" placeholder="Name or email"></div>
                        <div class="inv-field full"><label for="peripheralWorkstationInput">Linked workstation</label><select class="inv-select" id="peripheralWorkstationInput"><option value="">No linked workstation</option></select></div>
                    </div>
                </section>
                <section class="inv-section inv-hidden" id="workstationEditSection">
                    <h2>Manual workstation details</h2>
                    <div class="inv-form-grid">
                        <div class="inv-field"><label for="workstationNameInput">Name</label><input class="inv-input" id="workstationNameInput" maxlength="256"></div>
                        <div class="inv-field"><label for="workstationSerialInput">Serial number</label><input class="inv-input" id="workstationSerialInput" maxlength="128"></div>
                        <div class="inv-field"><label for="workstationUuidInput">UUID</label><input class="inv-input" id="workstationUuidInput" maxlength="128"></div>
                        <div class="inv-field"><label for="workstationManufacturerInput">Manufacturer</label><input class="inv-input" id="workstationManufacturerInput" maxlength="256"></div>
                        <div class="inv-field"><label for="workstationModelInput">Model</label><input class="inv-input" id="workstationModelInput" maxlength="256"></div>
                        <div class="inv-field"><label for="workstationOsInput">Operating system</label><input class="inv-input" id="workstationOsInput" maxlength="512"></div>
                        <div class="inv-field full"><label for="workstationUserInput">Assigned user</label><input class="inv-input" id="workstationUserInput" maxlength="256" placeholder="Name or email"></div>
                    </div>
                </section>
            </div>

            <div>
                <section class="inv-section">
                    <h2>Assignment</h2>
                    <div id="assignmentSummary"></div>
                    <div class="inv-field" id="manualAssignment"><label for="manualAssignee">Assign user manually</label><div class="inv-user-actions"><input class="inv-input" id="manualAssignee" maxlength="256" placeholder="Username or email"><button class="inv-button small" id="assignManualButton" type="button">Assign</button></div></div>
                    <div id="assignmentReview"></div>
                    <div id="conditionReview"></div>
                </section>

                <section class="inv-section">
                    <h2>Audit history</h2>
                    <div class="inv-history" id="historyList"></div>
                </section>
            </div>
        </div>
    </section>
</div>
<div class="inv-toast" id="toast"></div>

<div class="inv-modal-backdrop inv-hidden" id="workstationModal">
    <div class="inv-modal" role="dialog" aria-modal="true" aria-labelledby="workstationModalTitle">
        <div class="inv-modal-header"><h2 id="workstationModalTitle">Add workstation</h2><button class="inv-close" id="closeWorkstationModal" type="button" aria-label="Close">×</button></div>
        <div class="inv-modal-body">
            <div class="inv-form-grid">
                <div class="inv-field"><label for="addWorkstationName">Name *</label><input class="inv-input" id="addWorkstationName" maxlength="256"></div>
                <div class="inv-field"><label for="addWorkstationAssetTag">Asset tag</label><input class="inv-input" id="addWorkstationAssetTag" maxlength="128"></div>
                <div class="inv-field"><label for="addWorkstationSerial">Serial number</label><input class="inv-input" id="addWorkstationSerial" maxlength="128"></div>
                <div class="inv-field"><label for="addWorkstationUuid">UUID</label><input class="inv-input" id="addWorkstationUuid" maxlength="128"></div>
                <div class="inv-field"><label for="addWorkstationManufacturer">Manufacturer</label><input class="inv-input" id="addWorkstationManufacturer" maxlength="256"></div>
                <div class="inv-field"><label for="addWorkstationModel">Model</label><input class="inv-input" id="addWorkstationModel" maxlength="256"></div>
                <div class="inv-field"><label for="addWorkstationOs">Operating system</label><input class="inv-input" id="addWorkstationOs" maxlength="512"></div>
                <div class="inv-field"><label for="addWorkstationUser">Assigned user</label><input class="inv-input" id="addWorkstationUser" maxlength="256" placeholder="Name or email"></div>
                <div class="inv-field"><label for="addWorkstationStatus">Status</label><select class="inv-select" id="addWorkstationStatus"></select></div>
                <div class="inv-field"><label for="addWorkstationLocation">Location</label><input class="inv-input" id="addWorkstationLocation" maxlength="256"></div>
                <div class="inv-field"><label for="addWorkstationPurchaseDate">Purchase date</label><input class="inv-input" id="addWorkstationPurchaseDate" type="date"></div>
                <div class="inv-field"><label for="addWorkstationWarrantyEnd">Warranty end</label><input class="inv-input" id="addWorkstationWarrantyEnd" type="date"></div>
                <div class="inv-field full"><label for="addWorkstationNotes">Notes</label><textarea class="inv-textarea" id="addWorkstationNotes" maxlength="4000"></textarea></div>
            </div>
        </div>
        <div class="inv-modal-footer">
            <button class="inv-button" id="cancelWorkstation" type="button">Cancel</button>
            <button class="inv-button primary" id="saveWorkstation" type="button">Save</button>
        </div>
    </div>
</div>

<div class="inv-modal-backdrop inv-hidden" id="peripheralModal">
    <div class="inv-modal" role="dialog" aria-modal="true" aria-labelledby="peripheralModalTitle">
        <div class="inv-modal-header"><h2 id="peripheralModalTitle">Add peripheral</h2><button class="inv-close" id="closePeripheralModal" type="button" aria-label="Close">×</button></div>
        <div class="inv-modal-body">
            <div class="inv-form-grid">
                <div class="inv-field"><label for="addType">Type *</label><select class="inv-select" id="addType"></select></div>
                <div class="inv-field"><label for="addName">Name</label><input class="inv-input" id="addName" maxlength="256" placeholder="Defaults to manufacturer/model or type"></div>
                <div class="inv-field"><label for="addAssetTag">Asset tag</label><input class="inv-input" id="addAssetTag" maxlength="128"></div>
                <div class="inv-field"><label for="addSerial">Serial number</label><input class="inv-input" id="addSerial" maxlength="128"></div>
                <div class="inv-field"><label for="addManufacturer">Manufacturer</label><input class="inv-input" id="addManufacturer" maxlength="256"></div>
                <div class="inv-field"><label for="addModel">Model</label><input class="inv-input" id="addModel" maxlength="256"></div>
                <div class="inv-field"><label for="addAssignedUser">Assigned user</label><input class="inv-input" id="addAssignedUser" maxlength="256" placeholder="Name or email"></div>
                <div class="inv-field"><label for="addWorkstation">Linked workstation</label><select class="inv-select" id="addWorkstation"><option value="">No linked workstation</option></select></div>
                <div class="inv-field"><label for="addStatus">Status</label><select class="inv-select" id="addStatus"></select></div>
                <div class="inv-field"><label for="addLocation">Location</label><input class="inv-input" id="addLocation" maxlength="256"></div>
                <div class="inv-field"><label for="addPurchaseDate">Purchase date</label><input class="inv-input" id="addPurchaseDate" type="date"></div>
                <div class="inv-field"><label for="addWarrantyEnd">Warranty end</label><input class="inv-input" id="addWarrantyEnd" type="date"></div>
                <div class="inv-field full"><label for="addNotes">Notes</label><textarea class="inv-textarea" id="addNotes" maxlength="4000"></textarea></div>
            </div>
        </div>
        <div class="inv-modal-footer">
            <button class="inv-button" id="cancelPeripheral" type="button">Cancel</button>
            <button class="inv-button" id="saveAndAnotherPeripheral" type="button">Save &amp; add another</button>
            <button class="inv-button primary" id="savePeripheral" type="button">Save</button>
        </div>
    </div>
</div>

<div class="inv-modal-backdrop inv-hidden" id="importModal">
    <div class="inv-modal" role="dialog" aria-modal="true" aria-labelledby="importModalTitle">
        <div class="inv-modal-header"><h2 id="importModalTitle">Import peripherals</h2><button class="inv-close" id="closeImportModal" type="button" aria-label="Close">×</button></div>
        <div class="inv-modal-body">
            <div class="inv-import-summary" id="importSummary"></div>
            <div class="inv-preview-wrap"><table class="inv-preview"><thead><tr><th>Row</th><th>Type</th><th>Name</th><th>Asset tag</th><th>Serial</th><th>Assigned user</th><th>Linked workstation</th><th>Validation</th></tr></thead><tbody id="importPreviewRows"></tbody></table></div>
        </div>
        <div class="inv-modal-footer">
            <button class="inv-button" id="cancelImport" type="button">Cancel</button>
            <button class="inv-button primary" id="confirmImport" type="button" disabled>Import all</button>
        </div>
    </div>
</div>

<script>window.INVENTORY_BOOT = {{{boot}}};</script>
<script>
(function () {
    'use strict';

    var boot = window.INVENTORY_BOOT || {};
    var state = {
        assets: [], selected: null, permissions: boot.permissions || [], loading: false,
        cardFilter: '', pendingListRequestId: '', pendingRequests: {}, requestedAssetId: '', activeTab: 'workstations',
        peripheralTypes: boot.peripheralTypes || ['Mouse', 'Keyboard', 'Headset', 'Monitor', 'Other'], capabilities: {},
        importRows: [], importPreview: [], keepAddAnother: false, page: 1, pageSize: 25, settings: null
    };
    var requestCounter = 0;
    var frameRequestPrefix = (boot.mode === 'device' ? 'device' : 'dashboard') + '-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);

    function byId(id) { return document.getElementById(id); }
    function can(permission) { return state.permissions.indexOf(permission) >= 0; }
    function value(value, fallback) { return value === null || value === undefined || value === '' ? (fallback || '') : String(value); }
    function formatDate(input) {
        if (!input) return '—';
        var date = new Date(input);
        return isNaN(date.getTime()) ? '—' : date.toLocaleString();
    }
    function formatBytes(input) {
        var bytes = Number(input) || 0;
        if (!bytes) return '—';
        var units = ['B', 'KB', 'MB', 'GB', 'TB'];
        var index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
        return (bytes / Math.pow(1024, index)).toFixed(index > 2 ? 1 : 0) + ' ' + units[index];
    }
    function statusClass(status) { return value(status).toLowerCase().replace(/[^a-z0-9]+/g, '-'); }
    function node(tag, className, content) {
        var element = document.createElement(tag);
        if (className) element.className = className;
        if (content !== undefined) element.textContent = value(content);
        return element;
    }
    function clear(element) { while (element.firstChild) element.removeChild(element.firstChild); }
    function isPeripheral(asset) { return asset && asset.assetKind === 'peripheral'; }
    function isManualWorkstation(asset) { return asset && !isPeripheral(asset) && asset.source === 'manual'; }
    function assetsForTab() {
        var archived = byId('recordFilter').value === 'archived';
        return state.assets.filter(function (asset) {
            return (state.activeTab === 'peripherals' ? isPeripheral(asset) : !isPeripheral(asset)) && ((asset.recordState === 'Archived') === archived);
        });
    }
    function workstationAssets() {
        return state.assets.filter(function (asset) { return !isPeripheral(asset) && asset.recordState !== 'Archived'; }).sort(function (a, b) {
            return value(a.name).localeCompare(value(b.name));
        });
    }
    function populateTypes(select, selected) {
        clear(select);
        state.peripheralTypes.forEach(function (type) { select.appendChild(new Option(type, type)); });
        if (selected) select.value = selected;
    }
    function populateWorkstations(select, selected) {
        clear(select);
        select.appendChild(new Option('No linked workstation', ''));
        workstationAssets().forEach(function (asset) {
            var serial = value(asset.identity && asset.identity.serial);
            select.appendChild(new Option(value(asset.name, 'Unnamed workstation') + (serial ? ' · ' + serial : ''), asset.id));
        });
        select.value = selected || '';
    }

    function showToast(message, error) {
        var toast = byId('toast');
        toast.textContent = message;
        toast.className = 'inv-toast' + (error ? ' error' : '');
        toast.style.display = 'block';
        setTimeout(function () { toast.style.display = 'none'; }, 4500);
    }

    function setLoading(loading) {
        state.loading = loading;
        byId('inventoryRoot').classList.toggle('inv-loading', loading);
    }

    function send(action, payload, connectionAttempt, responseAttempt) {
        var attempt = Number(connectionAttempt) || 0;
        var replyAttempt = Number(responseAttempt) || 0;
        if (!window.parent || !window.parent.meshserver || window.parent.meshserver.State !== 2 || typeof window.parent.meshserver.send !== 'function') {
            if (attempt < 60) {
                setTimeout(function () { send(action, payload, attempt + 1, replyAttempt); }, 250);
            } else {
                setLoading(false);
                showToast('MeshCentral connection is unavailable.', true);
            }
            return;
        }
        requestCounter++;
        var message = Object.assign({}, payload || {});
        message.action = 'plugin';
        message.plugin = 'inventory';
        message.pluginaction = action;
        message.requestId = 'inventory-' + frameRequestPrefix + '-' + requestCounter;
        if (action === 'list') {
            if (state.pendingListRequestId) delete state.pendingRequests[state.pendingListRequestId];
            state.pendingListRequestId = message.requestId;
        }
        state.pendingRequests[message.requestId] = { action: action };
        setLoading(true);
        window.parent.meshserver.send(message);
        if (action === 'list') {
            var sentRequestId = message.requestId;
            setTimeout(function () {
                if (state.pendingListRequestId !== sentRequestId) return;
                if (replyAttempt < 5) {
                    delete state.pendingRequests[sentRequestId];
                    send('list', payload || {}, 0, replyAttempt + 1);
                } else {
                    delete state.pendingRequests[sentRequestId];
                    state.pendingListRequestId = '';
                    setLoading(false);
                    showToast('Inventory did not receive a response from MeshCentral. Refresh or try again.', true);
                }
            }, 2000);
        }
    }

    function setAssetUrl(assetId) {
        if (boot.mode === 'device') return;
        state.requestedAssetId = assetId || '';
        try {
            if (typeof window.parent.urlargs === 'object' && window.parent.urlargs != null) {
                window.parent.urlargs.inventorytab = state.activeTab;
                if (assetId) window.parent.urlargs.inventoryasset = assetId;
                else delete window.parent.urlargs.inventoryasset;
            }
            var url = new URL(window.parent.location.href);
            if (assetId) url.searchParams.set('inventoryasset', assetId);
            else url.searchParams.delete('inventoryasset');
            url.searchParams.set('inventorytab', state.activeTab);
            window.parent.history.replaceState({}, window.parent.document.title, url.pathname + url.search + url.hash);
        } catch (error) { /* Parent URL persistence is best effort. */ }
    }

    function readRequestedAsset() {
        if (boot.mode === 'device') return '';
        try { return new URL(window.parent.location.href).searchParams.get('inventoryasset') || ''; }
        catch (error) { return ''; }
    }

    function readRequestedTab() {
        if (boot.mode === 'device') return 'workstations';
        try { return new URL(window.parent.location.href).searchParams.get('inventorytab') === 'peripherals' ? 'peripherals' : 'workstations'; }
        catch (error) { return 'workstations'; }
    }

    function setTabUrl() {
        if (boot.mode === 'device') return;
        try {
            if (typeof window.parent.urlargs === 'object' && window.parent.urlargs != null) {
                window.parent.urlargs.inventorytab = state.activeTab;
                delete window.parent.urlargs.inventoryasset;
            }
            var url = new URL(window.parent.location.href);
            url.searchParams.set('inventorytab', state.activeTab);
            url.searchParams.delete('inventoryasset');
            window.parent.history.replaceState({}, window.parent.document.title, url.pathname + url.search + url.hash);
        } catch (error) { /* Parent URL persistence is best effort. */ }
    }

    function setActiveTab(tab, updateUrl) {
        var nextTab = tab === 'peripherals' ? 'peripherals' : 'workstations';
        if (state.activeTab !== nextTab) byId('recordFilter').value = 'active';
        state.activeTab = nextTab;
        state.cardFilter = '';
        state.page = 1;
        byId('workstationsTab').classList.toggle('active', state.activeTab === 'workstations');
        byId('peripheralsTab').classList.toggle('active', state.activeTab === 'peripherals');
        var peripherals = state.activeTab === 'peripherals';
        byId('rescanButton').classList.toggle('inv-hidden', peripherals || !can('can_sync'));
        byId('settingsButton').classList.toggle('inv-hidden', peripherals || !state.capabilities.canCreateManualWorkstation || !can('can_manage'));
        if (peripherals) byId('settingsPanel').classList.add('inv-hidden');
        byId('addWorkstationButton').classList.toggle('inv-hidden', peripherals || !can('can_manage') || !state.capabilities.canCreateManualWorkstation);
        byId('templateButton').classList.toggle('inv-hidden', !peripherals || !can('can_manage'));
        byId('importButton').classList.toggle('inv-hidden', !peripherals || !can('can_manage'));
        byId('addPeripheralButton').classList.toggle('inv-hidden', !peripherals || !can('can_manage'));
        byId('reviewFilter').classList.toggle('inv-hidden', peripherals);
        byId('presenceFilter').classList.toggle('inv-hidden', peripherals);
        byId('typeFilter').classList.toggle('inv-hidden', !peripherals);
        byId('searchInput').placeholder = peripherals ? 'Search peripheral, serial, user, workstation…' : 'Search device, serial, user, location…';
        byId('reviewFilter').value = '';
        byId('presenceFilter').value = '';
        byId('typeFilter').value = '';
        if (updateUrl) setTabUrl();
        renderSummary();
        renderRows();
    }

    function syncTheme() {
        try {
            var parentDocument = window.parent.document;
            var parentTheme = parentDocument.getElementById('theme-stylesheet');
            var localTheme = byId('inventoryTheme');
            if (parentTheme && parentTheme.href && localTheme.href !== parentTheme.href) localTheme.href = parentTheme.href;
            var mode = parentDocument.documentElement.getAttribute('data-bs-theme');
            if (mode) document.documentElement.setAttribute('data-bs-theme', mode);
            var rootStyles = window.parent.getComputedStyle(parentDocument.documentElement);
            var bodyStyles = window.parent.getComputedStyle(parentDocument.body);
            var root = document.documentElement;
            var themeVariables = {
                '--inv-border': '--bs-border-color',
                '--inv-muted': '--bs-secondary-color',
                '--inv-surface': '--bs-tertiary-bg'
            };
            Object.keys(themeVariables).forEach(function (target) {
                var themeValue = rootStyles.getPropertyValue(themeVariables[target]).trim();
                if (themeValue) root.style.setProperty(target, themeValue);
            });
            var background = rootStyles.getPropertyValue('--bs-body-bg').trim() || bodyStyles.backgroundColor;
            var foreground = rootStyles.getPropertyValue('--bs-body-color').trim() || bodyStyles.color;
            document.body.style.backgroundColor = background;
            document.body.style.fontFamily = bodyStyles.fontFamily;
            var rgb = (background.match(/[\d.]+/g) || []).map(Number);
            var luminance = rgb.length >= 3 ? ((rgb[0] * 299 + rgb[1] * 587 + rgb[2] * 114) / 1000) : 0;
            if (!foreground || foreground === 'transparent') foreground = luminance > 145 ? '#171717' : '#e8e8e8';
            function colorRgb(color) {
                color = String(color || '').trim();
                var hex = color.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
                if (hex) {
                    var value = hex[1];
                    if (value.length === 3) value = value.split('').map(function (part) { return part + part; }).join('');
                    return [parseInt(value.slice(0, 2), 16), parseInt(value.slice(2, 4), 16), parseInt(value.slice(4, 6), 16)];
                }
                var parts = color.match(/[\d.]+/g);
                return parts && parts.length >= 3 ? parts.slice(0, 3).map(Number) : null;
            }
            function colorLuminance(color) {
                var parts = colorRgb(color);
                if (!parts) return null;
                return parts.map(function (part) {
                    var channel = part / 255;
                    return channel <= 0.03928 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4);
                }).reduce(function (total, channel, index) {
                    return total + channel * [0.2126, 0.7152, 0.0722][index];
                }, 0);
            }
            function contrast(first, second) {
                var a = colorLuminance(first);
                var b = colorLuminance(second);
                if (a == null || b == null) return 0;
                return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
            }
            var accentCandidates = [
                rootStyles.getPropertyValue('--bs-primary').trim(),
                rootStyles.getPropertyValue('--bs-info').trim(),
                rootStyles.getPropertyValue('--bs-link-color').trim(),
                foreground
            ].filter(Boolean);
            var accent = accentCandidates[0] || '#168fbd';
            for (var candidateIndex = 0; candidateIndex < accentCandidates.length; candidateIndex++) {
                if (contrast(accentCandidates[candidateIndex], background) >= 3) {
                    accent = accentCandidates[candidateIndex];
                    break;
                }
            }
            root.style.setProperty('--inv-accent', accent);
            root.style.setProperty('--inv-on-accent', contrast('#fff', accent) >= contrast('#171717', accent) ? '#fff' : '#171717');
            root.style.setProperty('--inv-fg', foreground);
            document.body.style.color = foreground;
            root.classList.toggle('inv-classic-light', !parentTheme && luminance > 145);
        } catch (error) { /* Same-origin theme sync is best effort. */ }
    }

    function assignmentText(asset) {
        var assignment = asset.assignment || {};
        var names = (assignment.assignees || []).map(function (item) { return item.display || item.id; });
        if (names.length === 0) return 'Unassigned';
        return (assignment.mode === 'shared' ? 'Shared: ' : '') + names.join(', ');
    }

    function needsReview(asset) {
        return ((asset.assignment && asset.assignment.pending) || []).length > 0 || (asset.identityConflicts || []).length > 0 || (asset.duplicateConflicts || []).length > 0 || (asset.reviews || []).some(function (item) { return !item.snoozedUntil || Date.parse(item.snoozedUntil + 'T23:59:59Z') < Date.now(); });
    }

    function summarizeAssets(assets) {
        var result = { total: assets.length, assigned: 0, available: 0, review: 0, repair: 0, retired: 0 };
        assets.forEach(function (asset) {
            if (asset.status === 'Assigned') result.assigned++;
            if (asset.status === 'Available' || asset.status === 'Discovered') result.available++;
            if (asset.status === 'In Repair') result.repair++;
            if (asset.status === 'Retired') result.retired++;
            if (needsReview(asset)) result.review++;
        });
        return result;
    }

    function selectCardFilter(key) {
        state.cardFilter = key === 'all' ? '' : (state.cardFilter === key ? '' : key);
        state.page = 1;
        byId('statusFilter').value = '';
        byId('reviewFilter').value = '';
        byId('presenceFilter').value = '';
        renderSummary();
        renderRows();
    }

    function renderSummary() {
        var summary = summarizeAssets(assetsForTab());
        var cards = [
            [state.activeTab === 'peripherals' ? 'Total peripherals' : 'Total workstations', summary.total || 0, 'all'],
            ['Assigned', summary.assigned || 0, 'assigned'],
            ['Available', summary.available || 0, 'available'],
            ['Needs review', summary.review || 0, 'review'],
            ['In repair', summary.repair || 0, 'repair'],
            ['Retired', summary.retired || 0, 'retired']
        ];
        var container = byId('summaryCards');
        clear(container);
        cards.forEach(function (item) {
            var active = (item[2] === 'all' && !state.cardFilter) || state.cardFilter === item[2];
            var card = node('button', 'inv-card' + (active ? ' active' : ''));
            card.type = 'button';
            card.setAttribute('aria-pressed', active ? 'true' : 'false');
            card.addEventListener('click', function () { selectCardFilter(item[2]); });
            card.appendChild(node('div', 'inv-card-label', item[0]));
            card.appendChild(node('div', 'inv-card-value', item[1]));
            container.appendChild(card);
        });
    }

    function filteredAssets() {
        var search = byId('searchInput').value.trim().toLowerCase();
        var status = byId('statusFilter').value;
        var peripheralType = byId('typeFilter').value;
        var review = byId('reviewFilter').value;
        var presence = byId('presenceFilter').value;
        var now = Date.now();
        return assetsForTab().filter(function (asset) {
            if (state.cardFilter === 'assigned' && asset.status !== 'Assigned') return false;
            if (state.cardFilter === 'available' && asset.status !== 'Available' && asset.status !== 'Discovered') return false;
            if (state.cardFilter === 'review' && !needsReview(asset)) return false;
            if (state.cardFilter === 'repair' && asset.status !== 'In Repair') return false;
            if (state.cardFilter === 'retired' && asset.status !== 'Retired') return false;
            if (status && asset.status !== status) return false;
            if (peripheralType && (!asset.peripheral || asset.peripheral.type !== peripheralType)) return false;
            if (review === 'review' && !needsReview(asset)) return false;
            if (review === 'clear' && needsReview(asset)) return false;
            var automatic = asset.automatic || {};
            if (presence === 'online' && !automatic.online) return false;
            if (presence === 'offline' && automatic.online) return false;
            if (presence.indexOf('stale') === 0) {
                if (automatic.online || !automatic.lastSeen) return false;
                var days = Number(presence.substring(5));
                var lastSeen = new Date(automatic.lastSeen).getTime();
                if (!isFinite(lastSeen) || lastSeen > (now - (days * 24 * 60 * 60 * 1000))) return false;
            }
            if (!search) return true;
            var haystack = [
                asset.name, asset.meshName, asset.status,
                asset.identity && asset.identity.serial,
                asset.identity && asset.identity.uuid,
                asset.automatic && asset.automatic.manufacturer,
                asset.automatic && asset.automatic.model,
                asset.manualHardware && asset.manualHardware.manufacturer,
                asset.manualHardware && asset.manualHardware.model,
                asset.manualHardware && asset.manualHardware.osName,
                asset.peripheral && asset.peripheral.type,
                asset.peripheral && asset.peripheral.manufacturer,
                asset.peripheral && asset.peripheral.model,
                asset.links && asset.links.workstationName,
                asset.manual && asset.manual.assetTag,
                asset.manual && asset.manual.location,
                assignmentText(asset)
            ].join(' ').toLowerCase();
            return haystack.indexOf(search) >= 0;
        });
    }

    function renderRows() {
        var filtered = filteredAssets();
        var pages = Math.max(1, Math.ceil(filtered.length / state.pageSize));
        if (state.page > pages) state.page = pages;
        if (state.page < 1) state.page = 1;
        var start = (state.page - 1) * state.pageSize;
        var assets = filtered.slice(start, start + state.pageSize);
        var body = byId('assetRows');
        var head = byId('assetHead');
        clear(body);
        clear(head);
        var header = document.createElement('tr');
        var headings = state.activeTab === 'peripherals'
            ? ['Type', 'Peripheral', 'Status', 'Assignee', 'Asset tag', 'Serial', 'Manufacturer / model', 'Linked workstation', 'Location']
            : ['Device', 'Status', 'Assignee', 'Serial', 'UUID', 'Model', 'Location', 'Agent', 'Review'];
        headings.forEach(function (heading) { header.appendChild(node('th', '', heading)); });
        head.appendChild(header);
        byId('resultCount').textContent = filtered.length ? ((start + 1) + '–' + (start + assets.length) + ' of ' + filtered.length) : '0 results';
        byId('previousPage').disabled = state.page <= 1;
        byId('nextPage').disabled = state.page >= pages;
        byId('emptyState').style.display = filtered.length ? 'none' : 'block';
        byId('emptyState').textContent = assetsForTab().length ? 'No assets match the current filters.' : (state.activeTab === 'peripherals' ? 'No peripherals have been added.' : 'No workstations found.');

        assets.forEach(function (asset) {
            var row = document.createElement('tr');
            row.addEventListener('click', function () { openAsset(asset.id); });

            if (state.activeTab === 'peripherals') {
                row.appendChild(node('td', '', value(asset.peripheral && asset.peripheral.type, 'Other')));
                var peripheralCell = document.createElement('td');
                peripheralCell.className = 'inv-device-cell';
                peripheralCell.appendChild(node('div', 'inv-device', asset.name || 'Unnamed peripheral'));
                peripheralCell.appendChild(node('div', 'inv-muted', 'Manual · No agent'));
                row.appendChild(peripheralCell);
                var peripheralStatus = document.createElement('td');
                peripheralStatus.appendChild(node('span', 'inv-badge ' + statusClass(asset.status), asset.status));
                row.appendChild(peripheralStatus);
                row.appendChild(node('td', '', assignmentText(asset)));
                row.appendChild(node('td', 'inv-mono', value(asset.manual && asset.manual.assetTag, '—')));
                row.appendChild(node('td', 'inv-mono', value(asset.identity && asset.identity.serial, '—')));
                row.appendChild(node('td', '', [value(asset.peripheral && asset.peripheral.manufacturer), value(asset.peripheral && asset.peripheral.model)].filter(Boolean).join(' ') || '—'));
                row.appendChild(node('td', '', value(asset.links && asset.links.workstationName, '—')));
                row.appendChild(node('td', '', value(asset.manual && asset.manual.location, '—')));
                body.appendChild(row);
                return;
            }

            var deviceCell = document.createElement('td');
            deviceCell.className = 'inv-device-cell';
            deviceCell.appendChild(node('div', 'inv-device', asset.name || 'Unnamed device'));
            deviceCell.appendChild(node('div', 'inv-muted', isManualWorkstation(asset) ? 'Manual · No agent' : (asset.meshName || 'No device group')));
            if (asset.recordState === 'Archived') deviceCell.appendChild(node('div', 'inv-muted', 'Archived'));
            row.appendChild(deviceCell);

            var statusCell = document.createElement('td');
            statusCell.appendChild(node('span', 'inv-badge ' + statusClass(asset.status), asset.status));
            row.appendChild(statusCell);
            row.appendChild(node('td', '', assignmentText(asset)));
            row.appendChild(node('td', 'inv-mono', value(asset.identity && asset.identity.serial, '—')));
            row.appendChild(node('td', 'inv-mono', value(asset.identity && asset.identity.uuid, '—')));
            var workstationHardware = isManualWorkstation(asset) ? (asset.manualHardware || {}) : (asset.automatic || {});
            row.appendChild(node('td', '', [value(workstationHardware.manufacturer), value(workstationHardware.model)].filter(Boolean).join(' ') || '—'));
            row.appendChild(node('td', '', value(asset.manual && asset.manual.location, '—')));
            var agentCondition = isManualWorkstation(asset) ? 'No agent' : value(asset.automatic && asset.automatic.condition, asset.automatic && asset.automatic.nodeExists === false ? 'Node missing' : (asset.automatic && asset.automatic.online ? 'Online' : 'Offline'));
            row.appendChild(node('td', agentCondition === 'Online' ? 'inv-online' : 'inv-offline', agentCondition));
            row.appendChild(node('td', needsReview(asset) ? 'inv-review' : 'inv-muted', needsReview(asset) ? 'Review required' : 'Clear'));
            body.appendChild(row);
        });
    }

    function addField(list, label, content, className) {
        list.appendChild(node('dt', '', label));
        list.appendChild(node('dd', className || '', value(content, '—')));
    }

    function renderAssignment(asset) {
        var assignment = asset.assignment || { mode: 'unassigned', assignees: [], pending: [] };
        var summary = byId('assignmentSummary');
        var review = byId('assignmentReview');
        clear(summary);
        clear(review);
        byId('manualAssignment').classList.toggle('inv-hidden', isPeripheral(asset) || !can('can_manage'));
        byId('manualAssignee').value = '';

        var modeLine = node('div', 'inv-muted', 'Mode: ' + value(assignment.mode, 'unassigned'));
        summary.appendChild(modeLine);
        summary.appendChild(node('div', 'inv-muted', 'Record: ' + value(asset.recordState, 'Active')));
        if ((assignment.assignees || []).length === 0) {
            summary.appendChild(node('div', '', 'No assigned user'));
        } else {
            (assignment.assignees || []).forEach(function (user) {
                summary.appendChild(node('div', 'inv-user', (user.display || user.id) + ' · ' + value(user.source, asset.source === 'manual' ? 'manual' : 'agent')));
            });
        }

        if (can('can_manage') && (assignment.assignees || []).length > 0) {
            var unassign = node('button', 'inv-button small', 'Unassign');
            unassign.type = 'button';
            unassign.addEventListener('click', function () { assignmentAction('unassign', {}); });
            summary.appendChild(unassign);
        }

        var pending = assignment.pending || [];
        if (pending.length > 0) review.appendChild(node('h3', 'inv-review', 'New signed-in users require review'));
        pending.forEach(function (user) {
            var line = node('div', 'inv-user');
            var info = node('div');
            info.appendChild(node('div', '', user.display || user.id));
            info.appendChild(node('div', 'inv-muted', 'First seen ' + formatDate(user.firstSeen)));
            line.appendChild(info);
            if (can('can_manage')) {
                var actions = node('div', 'inv-user-actions');
                [['replace', 'Make assignee'], ['share', 'Mark shared'], ['dismiss', 'Dismiss']].forEach(function (definition) {
                    var button = node('button', 'inv-button small', definition[1]);
                    button.type = 'button';
                    button.addEventListener('click', function () { assignmentAction(definition[0], user); });
                    actions.appendChild(button);
                });
                line.appendChild(actions);
            }
            review.appendChild(line);
        });

        (asset.identityConflicts || []).forEach(function (conflict) {
            var detail = 'Hardware identity conflict: ' + value(conflict.kind);
            if (conflict.expected || conflict.observed) {
                detail += ' (stored: ' + value(conflict.expected, '—') + ', reported: ' + value(conflict.observed, '—') + ')';
            }
            if (conflict.assetIds) detail += ' (' + conflict.assetIds.join(', ') + ')';
            var conflictLine = node('div', 'inv-user');
            conflictLine.appendChild(node('div', 'inv-review', detail));
            if (can('can_manage') && (conflict.kind === 'uuid-mismatch' || conflict.kind === 'serial-mismatch')) {
                var conflictActions = node('div', 'inv-user-actions');
                var accept = node('button', 'inv-button small', 'Accept reported');
                accept.type = 'button';
                accept.addEventListener('click', function () {
                    if (window.confirm('Replace the stored hardware identity with the reported value? This change will be recorded in audit history.')) {
                        identityAction('accept', conflict);
                    }
                });
                var keep = node('button', 'inv-button small', 'Keep stored');
                keep.type = 'button';
                keep.addEventListener('click', function () { identityAction('keep', conflict); });
                conflictActions.appendChild(accept);
                conflictActions.appendChild(keep);
                conflictLine.appendChild(conflictActions);
            }
            review.appendChild(conflictLine);
        });

        (asset.duplicateConflicts || []).forEach(function (conflict) {
            var matches = (conflict.matches || []).join(', ');
            var source = conflict.otherSource === 'manual' ? 'manual' : 'automatic';
            review.appendChild(node('div', 'inv-review', 'Possible duplicate ' + source + ' workstation: ' + value(conflict.otherName, conflict.otherAssetId) + (matches ? ' (matching ' + matches + ')' : '')));
        });
        renderConditionReviews(asset);
    }

    function reviewAction(action, reason, until) {
        if (!state.selected) return;
        send('review', { assetId: state.selected.id, reviewAction: action, reason: reason || '', until: until || '' });
    }

    function renderConditionReviews(asset) {
        var container = byId('conditionReview');
        clear(container);
        (asset.reviews || []).forEach(function (item) {
            var line = node('div', 'inv-user');
            var messages = {
                'stale-device': 'Agent has been offline beyond the stale threshold.',
                'node-missing': 'MeshCentral node is missing. The inventory record is retained.',
                'assignment-missing': 'Lifecycle is Assigned, but no user is assigned.',
                'archived-returned': 'An archived agent has returned. Restore this record after review.'
            };
            var label = messages[item.reason] || item.reason;
            if (item.snoozedUntil && Date.parse(item.snoozedUntil + 'T23:59:59Z') > Date.now()) label += ' Snoozed until ' + item.snoozedUntil + '.';
            line.appendChild(node('div', 'inv-review', label));
            if (can('can_manage')) {
                var actions = node('div', 'inv-user-actions');
                function addAction(title, action) {
                    var button = node('button', 'inv-button small', title);
                    button.type = 'button';
                    button.addEventListener('click', action);
                    actions.appendChild(button);
                }
                if (item.reason === 'assignment-missing') addAction('Assign user', function () { byId('manualAssignee').focus(); });
                if (item.reason === 'stale-device' || item.reason === 'node-missing') {
                    addAction('Keep active', function () { reviewAction('acknowledge', item.reason); });
                    addAction('Snooze', function () {
                        var date = window.prompt('Snooze until date (YYYY-MM-DD):');
                        if (date) reviewAction('snooze', item.reason, date);
                    });
                    addAction('Archive', function () { reviewAction('archive', item.reason); });
                    addAction('Retire', function () { reviewAction('retire', item.reason); });
                }
                if (item.reason === 'archived-returned' && state.capabilities.canCreateManualWorkstation) addAction('Restore', function () { reviewAction('restore', item.reason); });
                line.appendChild(actions);
            }
            container.appendChild(line);
        });
        if (asset.recordState === 'Archived' && can('can_manage') && state.capabilities.canCreateManualWorkstation && !(asset.reviews || []).some(function (item) { return item.reason === 'archived-returned'; })) {
            var restore = node('button', 'inv-button small', 'Restore archived record');
            restore.type = 'button';
            restore.addEventListener('click', function () { reviewAction('restore', ''); });
            container.appendChild(restore);
        }
    }

    function renderHistory(asset) {
        var container = byId('historyList');
        clear(container);
        var history = (asset.history || []).slice().reverse();
        if (!history.length) {
            container.appendChild(node('div', 'inv-muted', 'No audit events recorded.'));
            return;
        }
        var conflictHistory = history.filter(function (entry) { return entry.action === 'identity.conflict'; });
        if (conflictHistory.length > 1) {
            var group = document.createElement('details');
            group.className = 'inv-history-item';
            var groupTitle = document.createElement('summary');
            groupTitle.className = 'inv-history-action';
            groupTitle.textContent = 'identity.conflict · ' + conflictHistory.length + ' observations (expand)';
            group.appendChild(groupTitle);
            conflictHistory.forEach(function (entry) {
                var nested = node('div', '', formatDate(entry.at) + ' · ' + value(entry.actor, 'system') + ' · ' + entry.details);
                nested.style.marginTop = '7px';
                group.appendChild(nested);
            });
            container.appendChild(group);
            history = history.filter(function (entry) { return entry.action !== 'identity.conflict'; });
        }
        history.forEach(function (entry) {
            var item = node('div', 'inv-history-item');
            item.appendChild(node('div', 'inv-history-action', entry.action));
            item.appendChild(node('div', '', entry.details));
            item.appendChild(node('div', 'inv-muted', formatDate(entry.at) + ' · ' + value(entry.actor, 'system')));
            container.appendChild(item);
        });
    }

