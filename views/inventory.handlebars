    function parseCsv(text) {
        var rows = [], row = [], field = '', quoted = false;
        text = value(text).replace(/^\ufeff/, '');
        for (var index = 0; index < text.length; index++) {
            var character = text[index];
            if (quoted) {
                if (character === '"' && text[index + 1] === '"') { field += '"'; index++; }
                else if (character === '"') quoted = false;
                else field += character;
            } else if (character === '"') quoted = true;
            else if (character === ',') { row.push(field); field = ''; }
            else if (character === '\n') { row.push(field.replace(/\r$/, '')); rows.push(row); row = []; field = ''; }
            else field += character;
        }
        if (quoted) throw new Error('The CSV contains an unclosed quoted field.');
        if (field || row.length) { row.push(field.replace(/\r$/, '')); rows.push(row); }
        rows = rows.filter(function (cells) { return cells.some(function (cell) { return value(cell).trim() !== ''; }); });
        if (rows.length < 2) throw new Error('The CSV must contain a header and at least one peripheral row.');
        var headers = rows[0].map(function (header) { return value(header).trim().toLowerCase().replace(/[\s-]+/g, '_'); });
        if (headers.indexOf('type') < 0) throw new Error('The CSV requires a "type" column. Download the template for the supported columns.');
        var unknown = headers.filter(function (header) { return peripheralCsvFields.indexOf(header) < 0; });
        if (unknown.length) throw new Error('Unsupported CSV column' + (unknown.length === 1 ? ': ' : 's: ') + unknown.join(', ') + '.');
        var duplicateHeaders = headers.filter(function (header, index) { return headers.indexOf(header) !== index; });
        if (duplicateHeaders.length) throw new Error('Duplicate CSV column: ' + duplicateHeaders[0] + '.');
        if (rows.length - 1 > 500) throw new Error('A maximum of 500 peripherals can be imported at once.');
        return rows.slice(1).map(function (cells, index) {
            if (cells.length > headers.length) throw new Error('CSV row ' + (index + 2) + ' has more columns than the header.');
            var record = { rowNumber: index + 2 };
            headers.forEach(function (header, column) { record[header] = value(cells[column]).trim(); });
            return record;
        });
    }

    function closeImportModal() {
        byId('importModal').classList.add('inv-hidden');
        state.importRows = [];
        state.importPreview = [];
    }

    function renderImportPreview(rows) {
        state.importPreview = rows || [];
        var invalid = state.importPreview.filter(function (row) { return row.errors && row.errors.length; }).length;
        byId('importSummary').textContent = state.importPreview.length + ' row' + (state.importPreview.length === 1 ? '' : 's') + ' · ' + (invalid ? invalid + ' require correction' : 'all rows valid');
        byId('importSummary').classList.toggle('inv-import-errors', invalid > 0);
        var body = byId('importPreviewRows');
        clear(body);
        state.importPreview.forEach(function (row) {
            var valueObject = row.value || {};
            var tr = document.createElement('tr');
            [row.rowNumber, valueObject.peripheralType, valueObject.name, valueObject.assetTag, valueObject.serial, valueObject.assignedUser,
                row.linkedWorkstation ? row.linkedWorkstation.name : valueObject.linkedWorkstation,
                row.errors && row.errors.length ? row.errors.join(' ') : 'Ready'].forEach(function (cell, index) {
                tr.appendChild(node('td', index === 7 && row.errors && row.errors.length ? 'inv-import-errors' : '', value(cell, '—')));
            });
            body.appendChild(tr);
        });
        byId('confirmImport').disabled = invalid > 0 || state.importPreview.length === 0;
        byId('importModal').classList.remove('inv-hidden');
    }

    function selectCsvFile(event) {
        var file = event.target.files && event.target.files[0];
        event.target.value = '';
        if (!file) return;
        if (file.size > 1024 * 1024) { showToast('CSV files are limited to 1 MB.', true); return; }
        var reader = new FileReader();
        reader.onload = function () {
            try {
                state.importRows = parseCsv(reader.result);
                send('peripheral-preview', { rows: state.importRows });
            } catch (error) { showToast(error.message || String(error), true); }
        };
        reader.onerror = function () { showToast('The CSV file could not be read.', true); };
        reader.readAsText(file);
    }

    function receive(message) {
        // MeshCentral delivers plugin responses through the parent page. More
        // than one Inventory iframe can exist there (the dashboard plus a
        // per-device tab), so only the frame that created this request may
        // consume its response.
        if (!message || !message.requestId || !state.pendingRequests[message.requestId]) return false;
        var pending = state.pendingRequests[message.requestId];
        delete state.pendingRequests[message.requestId];
        if (message.requestId === state.pendingListRequestId) state.pendingListRequestId = '';
        setLoading(Object.keys(state.pendingRequests).length > 0);
        if (!message.ok) {
            if (pending.action === 'get' && !state.selected) setAssetUrl('');
            showToast(message.error || 'Inventory request failed.', true);
            return true;
        }
        var result = message.result || {};
        if (result.kind === 'list') {
            state.pendingListRequestId = '';
            state.assets = result.assets || [];
            state.permissions = result.permissions || state.permissions;
            state.peripheralTypes = result.peripheralTypes || state.peripheralTypes;
            state.capabilities = result.capabilities || state.capabilities;
            state.settings = result.settings || state.settings;
            if (state.settings) {
                byId('staleMode').value = state.settings.mode || 'meshcentral';
                byId('staleDays').value = state.settings.days || 30;
                byId('ignoredUsers').value = (state.settings.ignoredUsers || []).join('\n');
            }
            byId('settingsWarning').textContent = result.settingsWarning || '';
            setActiveTab(state.activeTab, false);
            if (boot.nodeid) {
                var matching = state.assets.find(function (asset) { return asset.nodeid === boot.nodeid || (asset.nodeids || []).indexOf(boot.nodeid) >= 0; });
                if (matching) openAsset(matching.id);
                else showToast('This device has not been synchronized into inventory yet.', true);
            } else if (state.requestedAssetId && !state.selected) {
                var requested = state.assets.find(function (asset) { return asset.id === state.requestedAssetId; });
                if (requested) openAsset(requested.id);
                else {
                    setAssetUrl('');
                    showToast('The requested inventory asset no longer exists.', true);
                }
            }
        } else if (result.kind === 'asset') {
            var asset = result.asset;
            var index = state.assets.findIndex(function (item) { return item.id === asset.id; });
            if (index >= 0) state.assets[index] = asset;
            renderSummary();
            renderRows();
            renderDetail(asset);
        } else if (result.kind === 'deleted') {
            state.assets = state.assets.filter(function (asset) { return asset.id !== result.assetId; });
            closeDetail();
            showToast('Inventory record permanently deleted.');
        } else if (result.kind === 'workstation-created') {
            var workstation = result.asset;
            var workstationIndex = state.assets.findIndex(function (item) { return item.id === workstation.id; });
            if (workstationIndex >= 0) state.assets[workstationIndex] = workstation;
            else state.assets.push(workstation);
            state.assets.sort(function (a, b) { return value(a.name).localeCompare(value(b.name)); });
            closeWorkstationModal();
            setActiveTab('workstations', true);
            showToast('Workstation added.');
        } else if (result.kind === 'peripheral-preview') {
            renderImportPreview(result.rows || []);
        } else if (result.kind === 'peripheral-created' || result.kind === 'peripheral-imported') {
            (result.assets || []).forEach(function (asset) {
                var index = state.assets.findIndex(function (item) { return item.id === asset.id; });
                if (index >= 0) state.assets[index] = asset;
                else state.assets.push(asset);
            });
            state.assets.sort(function (a, b) { return value(a.name).localeCompare(value(b.name)); });
            state.activeTab = 'peripherals';
            setActiveTab('peripherals', true);
            if (result.kind === 'peripheral-created') {
                if (state.keepAddAnother) {
                    var rememberedType = byId('addType').value;
                    resetPeripheralForm();
                    byId('addType').value = rememberedType;
                    byId('addType').focus();
                    state.keepAddAnother = false;
                } else closePeripheralModal();
                showToast('Peripheral added.');
            } else {
                var importedCount = Number(result.count) || (result.assets || []).length;
                closeImportModal();
                showToast(importedCount + ' peripheral' + (importedCount === 1 ? '' : 's') + ' imported.');
            }
        } else if (result.kind === 'rescan') {
            showToast('Inventory synchronization completed.');
            send('list', {});
        } else if (result.kind === 'settings') {
            state.settings = result.settings;
            byId('settingsWarning').textContent = result.settingsWarning || '';
            showToast('Inventory settings saved.');
            send('list', {});
        }
        return true;
    }

    function initialize() {
        syncTheme();
        state.requestedAssetId = readRequestedAsset();
        state.activeTab = readRequestedTab();
        try {
            var parentDocument = window.parent.document;
            new MutationObserver(syncTheme).observe(parentDocument.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
            var theme = parentDocument.getElementById('theme-stylesheet');
            if (theme) {
                new MutationObserver(syncTheme).observe(theme, { attributes: true, attributeFilter: ['href'] });
                theme.addEventListener('load', syncTheme);
            }
            byId('inventoryTheme').addEventListener('load', syncTheme);
        } catch (error) { }

        (boot.lifecycleStates || []).forEach(function (status) {
            byId('statusFilter').appendChild(new Option(status, status));
            byId('statusInput').appendChild(new Option(status, status));
            byId('addStatus').appendChild(new Option(status, status));
            byId('addWorkstationStatus').appendChild(new Option(status, status));
        });
        populateTypes(byId('peripheralTypeInput'), 'Mouse');
        populateTypes(byId('addType'), 'Mouse');
        state.peripheralTypes.forEach(function (type) { byId('typeFilter').appendChild(new Option(type, type)); });
        byId('workstationsTab').addEventListener('click', function () { setActiveTab('workstations', true); });
        byId('peripheralsTab').addEventListener('click', function () { setActiveTab('peripherals', true); });
        byId('searchInput').addEventListener('input', function () { state.page = 1; renderRows(); });
        byId('statusFilter').addEventListener('change', function () { state.page = 1; state.cardFilter = ''; renderSummary(); renderRows(); });
        byId('typeFilter').addEventListener('change', function () { state.page = 1; renderRows(); });
        byId('reviewFilter').addEventListener('change', function () { state.page = 1; state.cardFilter = ''; renderSummary(); renderRows(); });
        byId('presenceFilter').addEventListener('change', function () { state.page = 1; renderRows(); });
        byId('recordFilter').addEventListener('change', function () { state.page = 1; state.cardFilter = ''; renderSummary(); renderRows(); });
        byId('pageSize').addEventListener('change', function () { state.pageSize = Number(this.value) || 25; state.page = 1; renderRows(); });
        byId('previousPage').addEventListener('click', function () { if (state.page > 1) { state.page--; renderRows(); } });
        byId('nextPage').addEventListener('click', function () { var pages = Math.max(1, Math.ceil(filteredAssets().length / state.pageSize)); if (state.page < pages) { state.page++; renderRows(); } });
        byId('saveButton').addEventListener('click', saveAsset);
        byId('deleteButton').addEventListener('click', deleteAsset);
        byId('exportButton').addEventListener('click', exportCsv);
        byId('rescanButton').addEventListener('click', function () { send('rescan', {}); });
        byId('settingsButton').addEventListener('click', function () { byId('settingsPanel').classList.toggle('inv-hidden'); });
        byId('saveSettings').addEventListener('click', function () {
            send('settings-update', { settings: {
                mode: byId('staleMode').value,
                days: Number(byId('staleDays').value),
                ignoredUsers: byId('ignoredUsers').value.split(/\r?\n/).map(function (name) { return name.trim(); }).filter(Boolean)
            } });
        });
        byId('assignManualButton').addEventListener('click', function () {
            var user = byId('manualAssignee').value.trim();
            if (!user) { showToast('Enter a username or email.', true); return; }
            assignmentAction('manual-replace', { id: user, display: user });
        });
        byId('addWorkstationButton').addEventListener('click', openWorkstationModal);
        byId('closeWorkstationModal').addEventListener('click', closeWorkstationModal);
        byId('cancelWorkstation').addEventListener('click', closeWorkstationModal);
        byId('saveWorkstation').addEventListener('click', saveWorkstation);
        byId('templateButton').addEventListener('click', downloadPeripheralTemplate);
        byId('importButton').addEventListener('click', function () { byId('importFileInput').click(); });
        byId('importFileInput').addEventListener('change', selectCsvFile);
        byId('addPeripheralButton').addEventListener('click', openPeripheralModal);
        byId('closePeripheralModal').addEventListener('click', closePeripheralModal);
        byId('cancelPeripheral').addEventListener('click', closePeripheralModal);
        byId('savePeripheral').addEventListener('click', function () { savePeripheral(false); });
        byId('saveAndAnotherPeripheral').addEventListener('click', function () { savePeripheral(true); });
        byId('closeImportModal').addEventListener('click', closeImportModal);
        byId('cancelImport').addEventListener('click', closeImportModal);
        byId('confirmImport').addEventListener('click', function () { send('peripheral-import', { rows: state.importRows }); });
        byId('addAssignedUser').addEventListener('input', function () {
            if (this.value.trim()) byId('addStatus').value = 'Assigned';
            else if (byId('addStatus').value === 'Assigned') byId('addStatus').value = 'Available';
        });
        byId('addWorkstationUser').addEventListener('input', function () {
            if (this.value.trim()) byId('addWorkstationStatus').value = 'Assigned';
            else if (byId('addWorkstationStatus').value === 'Assigned') byId('addWorkstationStatus').value = 'Available';
        });
        byId('workstationUserInput').addEventListener('input', function () {
            if (this.value.trim()) byId('statusInput').value = 'Assigned';
            else if (byId('statusInput').value === 'Assigned') byId('statusInput').value = 'Available';
        });
        byId('peripheralUserInput').addEventListener('input', function () {
            if (this.value.trim()) byId('statusInput').value = 'Assigned';
            else if (byId('statusInput').value === 'Assigned') byId('statusInput').value = 'Available';
        });
        byId('openDeviceButton').addEventListener('click', function () {
            if (state.selected && state.selected.nodeid && window.parent.gotoDevice) window.parent.gotoDevice(state.selected.nodeid, 10);
        });
        if (boot.mode === 'device') {
            byId('inventoryTabs').classList.add('inv-hidden');
        }
        setActiveTab(state.activeTab, false);
        send('list', {});
    }

    window.InventoryApp = {
        receive: receive,
        refresh: function () { send('list', {}); },
        back: function () {
            if (!state.selected) return false;
            closeDetail();
            return true;
        }
    };
    initialize();
})();
</script>
</body>
</html>
