    var peripheralCsvFields = ['type', 'name', 'asset_tag', 'serial', 'manufacturer', 'model', 'assigned_user', 'linked_workstation', 'status', 'location', 'purchase_date', 'warranty_end', 'notes'];

    function csvText(rows) {
        return rows.map(function (row) {
            return row.map(function (cell) { return '"' + value(cell).replace(/"/g, '""') + '"'; }).join(',');
        }).join('\r\n');
    }

    function downloadCsv(filename, rows) {
        var blob = new Blob(['\ufeff' + csvText(rows)], { type: 'text/csv;charset=utf-8' });
        var objectUrl = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = objectUrl;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        link.remove();
        setTimeout(function () { URL.revokeObjectURL(objectUrl); }, 1000);
    }

    function exportCsv() {
        var rows;
        if (state.activeTab === 'peripherals') {
            rows = [peripheralCsvFields];
            filteredAssets().forEach(function (asset) {
                var assignee = asset.assignment && asset.assignment.assignees && asset.assignment.assignees[0];
                rows.push([
                    asset.peripheral && asset.peripheral.type, asset.name, asset.manual && asset.manual.assetTag,
                    asset.identity && asset.identity.serial, asset.peripheral && asset.peripheral.manufacturer,
                    asset.peripheral && asset.peripheral.model, assignee && (assignee.display || assignee.id),
                    asset.links && (asset.links.workstationAssetId || asset.links.workstationName), asset.status,
                    asset.manual && asset.manual.location, asset.manual && asset.manual.purchaseDate,
                    asset.manual && asset.manual.warrantyEnd, asset.manual && asset.manual.notes
                ]);
            });
            downloadCsv('meshcentral-peripherals-' + new Date().toISOString().substring(0, 10) + '.csv', rows);
            return;
        }
        rows = [['Device', 'Group', 'Lifecycle', 'Record state', 'Agent condition', 'Assignment mode', 'Assignees', 'Assignment sources', 'Serial', 'UUID', 'Manufacturer', 'Model', 'Asset tag', 'Location', 'Operating system', 'Last seen']];
        filteredAssets().forEach(function (asset) {
            var hardware = isManualWorkstation(asset) ? (asset.manualHardware || {}) : (asset.automatic || {});
            rows.push([
                asset.name, asset.meshName, asset.status, asset.recordState || 'Active', isManualWorkstation(asset) ? 'No agent' : asset.automatic.condition, asset.assignment.mode,
                (asset.assignment.assignees || []).map(function (item) { return item.display || item.id; }).join('; '),
                (asset.assignment.assignees || []).map(function (item) { return item.source || (isManualWorkstation(asset) ? 'manual' : 'agent'); }).join('; '),
                asset.identity.serial, asset.identity.uuid, hardware.manufacturer, hardware.model,
                asset.manual.assetTag, asset.manual.location, hardware.osName,
                asset.automatic.lastSeen ? new Date(asset.automatic.lastSeen).toISOString() : ''
            ]);
        });
        downloadCsv('meshcentral-workstations-' + new Date().toISOString().substring(0, 10) + '.csv', rows);
    }

